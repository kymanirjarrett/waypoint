@{
    ViewData["Title"] = "Riddhi Mahajan";
}

@* Riddhi: replace every [bracketed blank] with your own details, then delete this comment. *@

<header class="page-header">
    <p class="wp-back"><a asp-controller="About" asp-action="Index">Back to the team</a></p>
    <h1>Riddhi Mahajan</h1>
    <p class="lead">[Your major] student at the University of Cincinnati &middot; Destinations &amp; database</p>
</header>

<section class="wp-section">
    <div class="wp-profile">
        <div>
            <div class="img-placeholder" role="img" aria-label="Photo of Riddhi Mahajan (placeholder)">Photo coming soon</div>
        </div>
        <div class="wp-measure">
            <h2>Bio</h2>
            <p>
                Hi, I&rsquo;m Riddhi! I&rsquo;m a [year, e.g. junior] studying [your major] at the University of Cincinnati.
                I&rsquo;m originally from [your hometown], and I got into traveling because [what got you into travel].
            </p>
            <p>
                When I&rsquo;m not planning my next trip, I like [a hobby or two]. After graduation, I hope to [career goal].
            </p>

            <h2>My role on Waypoint</h2>
            <p>I built the <a asp-controller="Destinations" asp-action="Index">Destinations</a> section and the database behind it:</p>
            <ul>
                <li>The <code>Destination</code> model and the SQL Server LocalDB database, created with an Entity Framework Core migration</li>
                <li>The <code>DestinationsController</code>, which gets the database context through dependency injection</li>
                <li>The destination card grid with continent filters, a detail page for each destination, and a
                    <a asp-controller="Destinations" asp-action="Table">sortable table</a> showing every row in the database</li>
                <li>Unit tests for the Destinations pages</li>
            </ul>

            <h2>How I travel</h2>
            <dl>
                <dt>Travel style</dt>
                <dd>[e.g. city breaks, road trips, backpacking]</dd>
                <dt>Must-pack item</dt>
                <dd>[the one thing you never travel without]</dd>
                <dt>Dream destination</dt>
                <dd>[the place at the top of your list]</dd>
            </dl>

            <h2>Favorite trips</h2>
            <ul>
                <li><strong>[Place 1]</strong> &ndash; [one sentence on why you loved it]</li>
                <li><strong>[Place 2]</strong> &ndash; [one sentence on why you loved it]</li>
            </ul>
        </div>
    </div>
</section>
