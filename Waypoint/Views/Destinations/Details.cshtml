@model DestinationDetailsViewModel
@{
    ViewData["Title"] = Model.Destination.Name;
    ViewData["Description"] = Model.Destination.Summary;
    var usd = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}

<header class="page-header">
    <p class="wp-back"><a asp-action="Index">All destinations</a></p>
    <div>
        <h1>@Model.Destination.Name</h1>
        <p class="wp-place__meta mt-2">@Model.Destination.Country &middot; @Model.Destination.Continent</p>
    </div>
</header>

@if (!string.IsNullOrEmpty(Model.Destination.ImagePath))
{
    <figure class="wp-feature-photo">
        <img src="@Model.Destination.ImagePath" alt="@Model.Destination.ImageAlt" width="1600" height="1067" fetchpriority="high" />
        <figcaption class="wp-photo-credit">
            Photo: <a href="@Model.Destination.ImageCreditUrl" rel="noopener">@Model.Destination.ImageCredit on Unsplash</a>
        </figcaption>
    </figure>
}

<section class="wp-section">
    <div class="wp-detail">
        <article class="wp-measure">
            <p class="wp-detail__lead">@Model.Destination.Summary</p>
            <p>@Model.Destination.Description</p>
            @if (Model.Next is { } next)
            {
                <p class="wp-next">
                    Next destination:
                    <a asp-action="Details" asp-route-slug="@next.Slug">@next.Name, @next.Country</a>
                </p>
            }
        </article>
        <aside class="wp-facts" aria-labelledby="facts-heading">
            <h2 id="facts-heading">Before you go</h2>
            <dl>
                <div>
                    <dt>@Html.DisplayNameFor(m => m.Destination.BestTimeToVisit)</dt>
                    <dd>@Model.Destination.BestTimeToVisit</dd>
                </div>
                <div>
                    <dt>@Html.DisplayNameFor(m => m.Destination.AverageDailyBudgetUsd)</dt>
                    <dd>About @Model.Destination.AverageDailyBudgetUsd.ToString("C0", usd) a day</dd>
                </div>
                <div>
                    <dt>Team rating</dt>
                    <dd>@Model.Destination.Rating out of 5</dd>
                </div>
                <div>
                    <dt>@Html.DisplayNameFor(m => m.Destination.RecommendedBy)</dt>
                    <dd>@Model.Destination.RecommendedBy</dd>
                </div>
                <div>
                    <dt>Status</dt>
                    <dd>@(Model.Destination.Visited ? "Visited" : "On the wish list")</dd>
                </div>
            </dl>
        </aside>
    </div>
</section>
