@model IEnumerable<Destination>
@{
    ViewData["Title"] = "Destinations";
    var continents = ViewData["Continents"] as List<string> ?? [];
    var selected = ViewData["SelectedContinent"] as string;
}

<section class="page-header">
    <div class="container">
        <h1>Destinations</h1>
        <p class="lead mb-0">Places we've been and places on our wish list, with what makes each one worth the trip.</p>
    </div>
</section>

<div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <nav aria-label="Filter by continent">
            <ul class="nav nav-pills continent-filter">
                <li class="nav-item">
                    <a class="nav-link @(string.IsNullOrEmpty(selected) ? "active" : "")"
                       aria-current="@(string.IsNullOrEmpty(selected) ? "page" : null)"
                       asp-action="Index">All</a>
                </li>
                @foreach (var continent in continents)
                {
                    var isActive = continent == selected;
                    <li class="nav-item">
                        <a class="nav-link @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)"
                           asp-action="Index" asp-route-continent="@continent">@continent</a>
                    </li>
                }
            </ul>
        </nav>
        <a class="btn btn-outline-secondary" asp-action="Table">View as table</a>
    </div>

    @if (!Model.Any())
    {
        <p>No destinations found.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var d in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <article class="card h-100 wp-card">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h2 class="h5 card-title mb-0">
                                    <a class="stretched-link text-decoration-none" asp-action="Details" asp-route-slug="@d.Slug">@d.Name</a>
                                </h2>
                                <span class="badge @(d.Visited ? "text-bg-success" : "text-bg-light")">@(d.Visited ? "Visited" : "Wish list")</span>
                            </div>
                            <p class="text-body-secondary small mb-2">@d.Country &middot; @d.Continent</p>
                            <p class="card-text flex-grow-1">@d.Summary</p>
                            <div class="d-flex justify-content-between small">
                                <span class="rating" aria-label="Rated @d.Rating out of 5">@(new string('★', d.Rating))@(new string('☆', 5 - d.Rating))</span>
                                <span>~@d.AverageDailyBudgetUsd.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"))/day</span>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
