@model IEnumerable<Destination>
@{
    ViewData["Title"] = "Destinations";
    var continents = ViewData["Continents"] as List<string> ?? [];
    var selected = ViewData["SelectedContinent"] as string;
    var usd = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}

<header class="page-header">
    <h1>Destinations</h1>
    <p class="lead">Places we&rsquo;ve been and places on our wish list, with what makes each one worth the trip.</p>
</header>

<section class="wp-section">
    <div class="wp-toolbar">
        <nav aria-label="Filter by continent">
            <ul class="wp-tabs">
                <li>
                    <a aria-current="@(string.IsNullOrEmpty(selected) ? "page" : null)" asp-action="Index">All</a>
                </li>
                @foreach (var continent in continents)
                {
                    <li>
                        <a aria-current="@(continent == selected ? "page" : null)" asp-action="Index" asp-route-continent="@continent">@continent</a>
                    </li>
                }
            </ul>
        </nav>
        <a class="btn btn-quiet" asp-action="Table">View as table</a>
    </div>

    @if (!Model.Any())
    {
        <p>No destinations found.</p>
    }
    else
    {
        <ul class="wp-grid list-unstyled m-0">
            @foreach (var d in Model)
            {
                <li class="wp-place">
                    @if (!string.IsNullOrEmpty(d.ImagePath))
                    {
                        <img class="wp-place__photo" src="@d.ImagePath" alt="@d.ImageAlt" width="1600" height="1067" loading="lazy" decoding="async" />
                    }
                    <partial name="_Stop" model="d.Visited" />
                    <h2><a asp-action="Details" asp-route-slug="@d.Slug">@d.Name</a></h2>
                    <p class="wp-place__meta">@d.Country &middot; @d.Continent</p>
                    <p class="wp-place__summary">@d.Summary</p>
                    <p class="wp-place__facts">
                        <span>Rated @d.Rating/5</span>
                        <span>About @d.AverageDailyBudgetUsd.ToString("C0", usd) a day</span>
                    </p>
                </li>
            }
        </ul>
    }
</section>
