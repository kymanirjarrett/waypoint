@model IEnumerable<Destination>
@{
    ViewData["Title"] = "Destination Data";
    var sort = ViewData["Sort"] as string ?? "name";
    var usd = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    var columns = new (string Key, string Label)[]
    {
        ("name", "Name"), ("country", "Country"), ("continent", "Continent"), ("budget", "Avg. daily budget"), ("rating", "Rating"),
    };
}

<header class="page-header">
    <p class="wp-back"><a asp-action="Index">Card view</a></p>
    <h1>Destination Data</h1>
    <p class="lead">Every row in the <code>Destinations</code> table of our SQL Server database. Select a column heading to sort.</p>
</header>

<section class="wp-section">
    <div class="wp-table-wrap" role="region" aria-labelledby="table-caption" tabindex="0">
        <table class="table table-striped table-hover align-middle wp-table">
            <caption id="table-caption">@Model.Count() destinations, sorted by @columns.First(c => c.Key == sort).Label.ToLower()<span class="d-md-none">. Scroll sideways for more columns.</span></caption>
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    @foreach (var (key, label) in columns)
                    {
                        <th scope="col" aria-sort="@(key == sort ? (key == "rating" ? "descending" : "ascending") : null)">
                            <a asp-action="Table" asp-route-sort="@key">@label</a>
                        </th>
                    }
                    <th scope="col">Best time to visit</th>
                    <th scope="col">Recommended by</th>
                    <th scope="col">Visited</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.Id</td>
                        <td><a asp-action="Details" asp-route-slug="@d.Slug">@d.Name</a></td>
                        <td>@d.Country</td>
                        <td>@d.Continent</td>
                        <td>@d.AverageDailyBudgetUsd.ToString("C0", usd)</td>
                        <td>@d.Rating / 5</td>
                        <td>@d.BestTimeToVisit</td>
                        <td>@d.RecommendedBy</td>
                        <td>@(d.Visited ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
