</header>

<section class="wp-section">

    @{
        var photos = new List<GalleryPhoto>
        {
            new("/images/gallery/ken-bitar-qTYn528bvT8-unsplash.webp", "A lighthouse on top of (or next to) a harbor-side building", "Hilton Head Island", "Ken Bitar", "https://unsplash.com/photos/a-lighthouse-tops-a-harbor-side-building-qTYn528bvT8"),
            new("/images/gallery/nikhil-mistry-xzq5VP4D_50-unsplash.webp", "A group of people on a Harbor Town pier at sunset", "Hilton Head Island", "Nikhil Mistry", "https://unsplash.com/photos/a-group-of-people-standing-on-a-pier-at-sunset-xzq5VP4D_50"),
            new("/images/gallery/tom-podmore-CDTL4Wtyi8w-unsplash.webp", "A group of boats floating along a coastline", "Negril, Jamiaca", "Tom Podmore", "https://unsplash.com/photos/a-group-of-boats-floating-on-top-of-a-body-of-water-CDTL4Wtyi8w"),
            new("/images/gallery/jaime-creixems-pGGxkUXbW-c-unsplash.webp", "Fireworks over Cinderella Castle", "Magic Kingdom, Florida", "Jaime Creixems", "https://unsplash.com/photos/fireworks-at-night-pGGxkUXbW-c"),
