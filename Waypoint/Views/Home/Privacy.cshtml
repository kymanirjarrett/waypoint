@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["Description"] = "What Waypoint collects: no accounts, no cookies, no ads or trackers, and short-lived diagnostics.";
}

<header class="page-header">
    <h1>Privacy</h1>
    <p class="lead">Short version: no accounts, no cookies, no ads, no trackers.</p>
</header>

<section class="wp-section">
    <div class="wp-measure">
        <h2 class="wp-title">What we collect</h2>
        <p>
            Nothing you type in, because there is nothing to type in. Waypoint has no accounts, forms, or comments,
            and it doesn&rsquo;t set cookies.
        </p>

        <h2 class="wp-title mt-5">What happens when you visit</h2>
        <ul>
            <li>
                The site runs on Microsoft Azure. When a page loads, Azure records technical details such as the page,
                the time, how long it took, and any error, so we can keep the site working. These diagnostics are deleted after 30 days.
            </li>
            <li>
                Your IP address is used for about a minute to stop any one visitor from overloading the site.
                Azure removes IP addresses from the diagnostics it stores.
            </li>
            <li>
                Fonts, images, and scripts are served from this site, not from third parties. Photo credit links go to Unsplash
                only if you click them.
            </li>
        </ul>

        <h2 class="wp-title mt-5">What we don&rsquo;t do</h2>
        <p>No advertising, no analytics trackers, and no selling or sharing of data.</p>

        <p class="wp-empty mt-5"><small>Last updated November 2026.</small></p>
    </div>
</section>
