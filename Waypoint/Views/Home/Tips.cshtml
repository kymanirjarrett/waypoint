@{
    ViewData["Title"] = "Tips";
}

<header class="page-header">
    <h1>Travel Tips</h1>
</header>

<section class="wp-section">

    <h2 class="wp-title">Packing</h2>
    <partial name="_TipCard"
        model='new Tip("Pack extra clothes", "Bring extra clothes in case something unexpected happens.")' />


    <h2 class="wp-title">Budgeting</h2>
    <partial name="_TipCard"
       model='new Tip("Track your expenses", "Keep track of purchases throughout your trip so you know where your money is going.")' />

   <h2 class="wp-title">Getting Around</h2>
   <partial name="_TipCard"
       model='new Tip("Plan your routes ahead of time", "Identify nearby attractions and group activities by location to reduce unnecessary travel.")' />
    
    <h2 class="wp-title">Lodging</h2>
    <partial name="_TipCard"
             model='new Tip("Book early", "Popular hotels and Airbnbs fill up quickly, so book your lodging as soon as you know your travel dates.")' />

    <h2 class="wp-title">Traveling (by Car)</h2>
    <partial name="_TipCard"
             model='new Tip("Take Breaks", "It is always important to take regular breaks during long drives to avoid fatigue.")' />

</section>
