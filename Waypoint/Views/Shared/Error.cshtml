@model ErrorViewModel
@using Microsoft.AspNetCore.Diagnostics
@{
    ViewData["Title"] = "Something went wrong";
    // The handler re-runs this page at /error; link back to the page that actually failed.
    var failedPath = Context.Features.Get<IExceptionHandlerPathFeature>()?.Path;
    // Only link to a path on this site: "//evil.example" would otherwise send the click to another origin.
    if (!Url.IsLocalUrl(failedPath)) { failedPath = "/"; }
}

@* Shown to visitors in production (UseExceptionHandler). Development shows the detailed exception page instead. *@
<section class="wp-section wp-notfound">
    <h1>Something went wrong</h1>
    <p class="wp-measure">
        The page didn&rsquo;t load this time. If the site has been quiet for a while, the database may still be waking up.
        Wait a few seconds and try again.
    </p>
    <p class="d-flex flex-wrap gap-3 m-0">
        <a class="btn btn-accent" href="@failedPath">Try again</a>
        <a class="btn btn-quiet" asp-controller="Home" asp-action="Index">Go home</a>
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="wp-empty m-0"><small>Reference: <code>@Model.RequestId</code></small></p>
    }
</section>
