<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Waypoint</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Waypoint.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main-content">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark site-navbar" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Waypoint</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @* Riddhi: uncomment in your Destinations PR. *@
                        @* <li class="nav-item">
                            <a class="nav-link" asp-controller="Destinations" asp-action="Index">Destinations</a>
                        </li> *@
                        @* Evan: uncomment in your Gallery/Tips PR. *@
                        @* <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Gallery">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Tips">Travel Tips</a>
                        </li> *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="aboutDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                About Us
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="aboutDropdown">
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Index">Team overview</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Kymani">Kymani</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Riddhi">Riddhi</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Evan">Evan</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="pb-4" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-3">
            Waypoint &middot; IT3047C &middot; University of Cincinnati &middot; &copy; @DateTime.Now.Year
            &middot; <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
